# E2E tests: Playwright + Firefox on same network as frontend.
# Build from repo root: podman build -f Dockerfile.e2e .
# Run via: make test-e2e (compose runs this with BASE_URL=http://frontend:4200)
# Version in install --with-deps should match @playwright/test in package.json.
FROM docker.io/node:20-bookworm

RUN npx -y playwright@1.49.0 install --with-deps firefox

WORKDIR /app

COPY front-end/poopyfeed/package.json front-end/poopyfeed/package-lock.json ./
COPY front-end/poopyfeed/playwright.config.ts ./
COPY front-end/poopyfeed/e2e ./e2e

RUN npm ci

# Use Firefox by default (reliable on Linux in container)
CMD ["npx", "playwright", "test", "--project=firefox"]
