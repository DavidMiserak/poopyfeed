# Container Image Configuration
# Copy this file to .env and modify as needed
# WARNING: Never commit .env to git — it contains secrets

################################################################################
# PRODUCTION SECRETS
# ⚠️  CHANGE THESE IN PRODUCTION
################################################################################

# Django secret key — used for cryptographic signing (sessions, CSRF tokens, etc.)
# PRODUCTION: Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DEVELOPMENT: Can use placeholder; Docker Compose provides a default
DJANGO_SECRET_KEY=change-me-in-dev-only

################################################################################
# Container Image Configuration
################################################################################

# Container registry (default: localhost for dev, use your registry URL for production)
REGISTRY=localhost

# Backend image name (default: poopyfeed-be)
BACKEND_IMAGE=poopyfeed-be

# Frontend image name (default: poopyfeed-fe)
FRONTEND_IMAGE=poopyfeed-fe

# Image tag (default: dev for local development, use semantic versions in production)
# PRODUCTION: Use semantic versioning (v1.2.3) or commit hash
# DEVELOPMENT: Default 'dev' tag is fine for local use
IMAGE_TAG=dev

# Android image name (default: poopyfeed-android)
ANDROID_IMAGE=poopyfeed-android

# PostgreSQL version (default: 14)
POSTGRES_VERSION=14

################################################################################
# Social Login (OAuth)
# Configure these to enable Google and Facebook sign-in
################################################################################

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com/apps/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
